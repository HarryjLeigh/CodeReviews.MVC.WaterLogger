@page
@model Update
@{
    ViewData["title"] = "Update Record";
}

<h4>Are you sure you want to update this record?</h4>
<hr/>

<div>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DrinkingWater.Date)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DrinkingWater.Date)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DrinkingWater.Quantity)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DrinkingWater.Quantity)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DrinkingWater.Size)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DrinkingWater.Size)
        </dd>
    </dl>
</div>


<div class="row">
    <div class="col-md-4">
        <form method="post">
            <input type="hidden" asp-for="DrinkingWater.Id">
            <div class="form-group">
                <label asp-for="DrinkingWater.Date" class="control-label"></label>
                <input type="date" asp-for="DrinkingWater.Date" class="form-control"/>
                <span asp-validation-for="DrinkingWater.Date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DrinkingWater.Quantity" class="control-label"></label>
                <input asp-for="DrinkingWater.Quantity" class="form-control"/>
                <span asp-validation-for="DrinkingWater.Quantity" class="text-danger"></span>
            </div>
            <div class="form-group increaseWidthInput input__box">
                <label asp-for="DrinkingWater.Size" class="control-label"></label>
                <input asp-for="DrinkingWater.Size" class="form-control resize"
                       placeholder="Enter: Big Bottle(1litre) / bottle(500ml) / glass(250ml)"/>
                <span asp-validation-for="DrinkingWater.Size" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="hidden" asp-for="DrinkingWater.Id">
                <input type="submit" value="Update" class="btn btn-success"/>
            </div>
        </form>
    </div>
</div>


<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}